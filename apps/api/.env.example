# ---------------------------------------------------------------
# 复制成 .env 后使用：cp apps/api/.env.example apps/api/.env
# 本地一键部署（start-earthworm.bat）用的是免安装 PostgreSQL / Redis，无密码
# ---------------------------------------------------------------
DATABASE_URL="postgres://postgres@127.0.0.1:5433/earthworm"
REDIS_URL="redis://127.0.0.1:6379"
SECRET="请改成一串随机字符"

# 本地认证：跳过 Logto 登录，使用固定 token（前端已内置同一个值）
# 想恢复官方多账号登录，把它改成 false 并自行部署 Logto
LOCAL_MODE=true
LOCAL_AUTH_TOKEN="earthworm-local-token"
LOCAL_USER_ID="local-user"

PORT=3001
BACKEND_ENDPOINT="http://localhost:3001/"

# ---------------------------------------------------------------
# 神经语音（微软 Edge Read Aloud，与 Azure TTS 同一套声学模型）
# 音色示例：en-US-JennyNeural（美音女）、en-GB-SoniaNeural（英音女）
# 换音色等于换缓存键，会重新合成全库
# ---------------------------------------------------------------
TTS_ENABLED=true
TTS_VOICE="en-US-JennyNeural"
TTS_RATE="+0%"

# 服务启动后自动补齐缺失音频，新导入的课程包靠它变成静态文件
TTS_AUTO_PREWARM=true
TTS_AUTO_PREWARM_DELAY_MS=15000

# 下面三项不填会按默认位置推断：python 走 PATH，缓存落在仓库根的 storage/tts
# TTS_PYTHON="python"
# TTS_WORKER_SCRIPT="./tools/tts-worker/worker.py"
# TTS_CACHE_DIR="./storage/tts"
TTS_CONCURRENCY=8

# 直连即可；网络受限时可填代理地址
TTS_PROXY=""

# 以下 Logto 配置在本地模式下不使用，保留占位以兼容原代码
LOGTO_ENDPOINT="http://localhost:3010/"
LOGTO_CLIENT_ID="local"
LOGTO_CLIENT_SECRET="local"
LOGTO_M2M_API="http://localhost:3010/api"
